{
  "name": "reciclaje-conecta",
  "version": "1.0.0",
  "description": "Plataforma que conecta generadores de residuos reciclables con puntos de acopio y recolectores",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --coverage",
    "build:client": "npm --prefix client install && npm --prefix client run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.2"
  }
}
